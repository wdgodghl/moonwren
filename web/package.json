{
  "name": "@wdgodghl/moonwren",
  "version": "0.9.3",
  "description": "Wren 0.4-compatible runtime compiled from MoonBit for browsers and Node.js",
  "type": "module",
  "scripts": {
    "test": "node sdk.test.mjs",
    "test:browser": "playwright test",
    "test:browser:deployed": "playwright test tests/deployed.spec.mjs"
  },
  "exports": {
    ".": {
      "types": "./sdk.d.ts",
      "import": "./sdk.mjs"
    },
    "./worker": "./worker.mjs"
  },
  "files": [
    "moonwren.js",
    "sdk.mjs",
    "sdk.d.ts",
    "worker.mjs"
  ],
  "sideEffects": [
    "./moonwren.js"
  ],
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/wdgodghl/moonwren"
}
